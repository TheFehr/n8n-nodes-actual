{
  "name": "n8n-nodes-actual",
  "version": "26.11.3",
  "description": "Interact with your Actual Budget instance",
  "license": "MIT",
  "homepage": "",
  "keywords": [
    "n8n-community-node-package"
  ],
  "author": {
    "name": "Philipp Fehr",
    "email": "philipp@thefehr.me"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TheFehr/n8n-nodes-actual.git"
  },
  "scripts": {
    "build": "n8n-node build && node scripts/bundle.mjs",
    "build:watch": "tsc --watch",
    "dev": "n8n-node dev",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "test": "vitest",
    "test:run": "vitest run",
    "test:pipeline": "bash scripts/full-test.sh",
    "release": "n8n-node release",
    "prepublishOnly": "n8n-node prerelease"
  },
  "files": [
    "dist",
    "vendor",
    "THIRD-PARTY-NOTICES.md"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": false,
    "credentials": [
      "dist/credentials/ActualBudgetApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/ActualBudget/ActualBudget.node.js"
    ]
  },
  "devDependencies": {
    "@actual-app/api": "26.11.0",
    "@n8n/node-cli": "*",
    "@types/node": "^25.5.2",
    "detect-libc": "^2.1.2",
    "esbuild": "^0.28.1",
    "eslint": "9.39.5",
    "prettier": "3.9.10",
    "release-it": "^21.0.0",
    "typescript": "5.9.3",
    "vite": "^8.0.0",
    "vitest": "^5.0.0"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "n8nWorkflowVersion": "2.46.5",
  "n8nNodeTooling": {
    "upstream": {
      "name": "Actual",
      "source": {
        "type": "npm",
        "package": "@actual-app/api"
      },
      "track": {
        "type": "devDependency",
        "name": "@actual-app/api"
      },
      "majorOffset": 0
    },
    "readme": "Last tested with n8n {n8n} and Actual {upstream}.",
    "pins": {
      "n8n-image": {
        "file": "docker-compose.test.yml",
        "template": "N8N_IMAGE: n8nio/n8n:{version}",
        "from": "n8n"
      },
      "n8n-base-image": {
        "file": "Dockerfile.test-n8n",
        "template": "ARG N8N_IMAGE=n8nio/n8n:{version}",
        "from": "n8n"
      },
      "actual-server-image": {
        "file": "docker-compose.test.yml",
        "template": "image: actualbudget/actual-server:{version}",
        "from": "upstream"
      }
    }
  }
}
